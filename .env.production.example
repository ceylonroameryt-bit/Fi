# ─────────────────────────────────────────────────────────────
# Ledgerline Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────

# Node Environment
NODE_ENV=production

# Server Ports
PORT=4000
PORT_WEB=3000

# PostgreSQL Connection String
DATABASE_URL=postgresql://ledgerline:ledgerline_prod_secret@localhost:5432/ledgerline

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=ledgerline_jwt_production_secret_key_change_me_before_production_deployment
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d

# Allowed Cross-Origin Domains (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://app.yourledgerline.com

# Next.js Public API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
