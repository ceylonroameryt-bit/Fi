# ─────────────────────────────────────────────────────────────
# Ledgerline Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` on your production deployment host (e.g. Render / Railway).
# All values marked REQUIRED must be explicitly populated.
#
# Generate cryptographically secure secrets (64+ characters) with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────

# Application Environment (enforces strict security guards)
APP_ENV=production
PORT=4000

# PostgreSQL Connection String (Transaction mode pooler or direct)
DATABASE_URL=postgresql://postgres.yourproject:YOUR_SECURE_PASSWORD@your-host:5432/postgres?sslmode=require

# Direct PostgreSQL URL (Required for Prisma migrations when using transaction poolers like PgBouncer)
DIRECT_URL=postgresql://postgres.yourproject:YOUR_SECURE_PASSWORD@your-host:5432/postgres?sslmode=require

# Cryptographic Authentication Secrets (REQUIRED, min 32 chars, 64+ recommended)
# Must differ from each other. Cannot use defaults or placeholders.
JWT_SECRET=
SESSION_SECRET=

# Token Lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Web frontend URL & Strict CORS Allowlist (comma-separated origins)
# Wildcards (*.vercel.app) and localhost origins are strictly forbidden in production.
FRONTEND_URL=https://app.yourledgerline.com
CORS_ALLOWED_ORIGINS=https://app.yourledgerline.com

# Cookie Security (forced true in production)
COOKIE_SECURE=true

# Logging & Telemetry
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
