# ──────────────────────────────────────────────────────────────
# Ledgerline API environment. Copy to `.env` and adjust.
# NEVER commit real secrets. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ──────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
PORT=4000

# PostgreSQL connection (the bundled `npm run db:start` server listens on 5433)
DATABASE_URL=postgresql://ledgerline:ledgerline_dev_password@localhost:5433/ledgerline?schema=public

# Secrets — minimum 32 characters each, must differ from each other.
# In development, built-in dev defaults will be used if omitted.
# In production, both MUST be explicitly provided (min 32 chars, 64+ recommended).
# Generate high-entropy secrets using:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_SECRET=

# Lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Web origin & CORS allowlist (comma-separated origins)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true when served behind HTTPS (marks cookies Secure). Forced true in production.
COOKIE_SECURE=false

# Optional. When set, enables Redis-backed infrastructure in future phases (not required now).
REDIS_URL=

# debug | info | warn | error
LOG_LEVEL=info

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Owners/accountants must pass MFA before accessing an organisation. Cannot be false in production.
MFA_REQUIRED_FOR_PRIVILEGED_ROLES=true

# AI gateway: none | anthropic | fake. 'anthropic' reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
# Minutes between background business-profile refreshes (0 = off)
AI_PROFILE_REFRESH_MINUTES=0

# Document upload: max bytes (default 20 MB) and OCR for photos/scans: none | textract | fake
DOCUMENT_MAX_BYTES=20971520
OCR_PROVIDER=none

# Background jobs (Postgres queue). Set JOB_WORKER_ENABLED=false to run workers in a separate process (and in tests).
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=1000
JOB_RETRY_BASE_MS=5000
JOB_RETRY_MAX_MS=600000
JOB_LOCK_TIMEOUT_MS=300000
DOCUMENT_JOBS_PER_ORG_PER_MINUTE=30
# Default monthly AI spend cap per organisation in USD (per-org override: organizations.ai_monthly_cost_limit_usd)
AI_MONTHLY_COST_LIMIT_USD=50
